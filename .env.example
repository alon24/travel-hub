# Public build config (ships in the bundle). Copy to .env.local for development.
# The OpenRouter key is NOT here: it lives only in the Worker's secrets (OPENROUTER_API_KEY).
VITE_WORKER_URL=
# Google sign-in (same OAuth client as MyMaps AI). Empty = no sign-in gate (local dev only).
VITE_GOOGLE_CLIENT_ID=
# Who may use the hub is the shared user list behind the Worker (manage it on the Admin page), not a build setting.
# Sibling apps. Empty = their GitHub Pages addresses. Set both to run all three apps locally on one origin.
VITE_SKYHOP_URL=
VITE_MYMAPS_URL=
