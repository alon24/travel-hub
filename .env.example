# Public build config (ships in the bundle). Copy to .env.local for development.
# The OpenRouter key is NOT here: it lives only in the Worker's secrets (OPENROUTER_API_KEY).
VITE_WORKER_URL=
# Google sign-in (same OAuth client as MyMaps AI). Empty = no sign-in gate (local dev only).
VITE_GOOGLE_CLIENT_ID=
# Who may use the hub: addresses or sha256:<hex of the lowercased address>, comma separated. Empty = any Google account.
VITE_ALLOWED_EMAILS=
